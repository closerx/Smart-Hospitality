# ==========================================
# SMART HOSPITALITY - Environment Variables Template
# ==========================================
# قم بنسخ هذا الملف إلى .env وأضف القيم الخاصة بك
# ⚠️ لا تقم أبداً برفع ملف .env الحقيقي إلى GitHub!

# --- Supabase Configuration (Client & Public) ---
VITE_SUPABASE_URL=https://your-supabase-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Email Service Configuration (Server & Cloudflare Pages Functions) ---
# مزود إرسال البريد Resend (https://resend.com)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=SMART HOSPITALITY <onboarding@resend.dev>

